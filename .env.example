# vLLM Cluster Manager — environment variables
# Copy to .env and adjust as needed. Values shown are defaults.
# See docs/operations.md for full descriptions.

# ── Host Backend ──
# WEBHOOK_URL=                          # Slack/generic webhook for deployment notifications
# EXPIRY_WARNING_MINUTES=30             # Warn N minutes before deployment auto-expires
# START_TIMEOUT_SECONDS=1800            # Mark deployment errored if stuck starting this long
# GATEWAY_TIMEOUT_SECONDS=600           # Non-streaming gateway request timeout
# NODE_METRICS_RETENTION_HOURS=48       # How long node metric history is kept
# BUSY_GUARD_SECONDS=60                 # Seconds after last request before warm-cache can evict
# TEMP_API_KEY_TTL_SECONDS=300          # Snippet API key lifespan (0 = disabled)

# ── Host Infrastructure ──
# POSTGRES_USER=vllm                    # Postgres username
# POSTGRES_PASSWORD=vllm                # Postgres password
# POSTGRES_DB=vllm_admin                # Postgres database name

# ── Client Agent ──
# MODEL_DIRS=                           # Comma-separated dirs for local models/LoRA adapters
# MAX_FAILED_RESTARTS=3                 # Crash-loop breaker (per deployment)
# HF_CACHE_DIR=~/.cache/huggingface    # Shared HuggingFace model cache
# LOG_MAX_MB=50                         # Rotate deployment log at this size
# LOG_RETENTION_DAYS=14                 # Delete old log files after this many days
# PODMAN_SOCK=                          # Non-standard Podman API socket path
